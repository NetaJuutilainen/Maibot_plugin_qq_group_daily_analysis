{
  "manifest_version": 2,
  "id": "maibot-plugin-qq-group-daily-analysis",
  "version": "1.0.1",
  "name": "群聊每日分析",
  "description": "每天自动生成群聊日报：高光话题、神人称号、金句宝藏瓶、聊天质量锐评，9 套主题可选，支持上传 QQ 群相册。",
  "author": {
    "name": "NetaJuutilainen",
    "url": "https://github.com/NetaJuutilainen"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/NetaJuutilainen/Maibot_plugin_qq_group_daily_analysis",
    "issues": "https://github.com/NetaJuutilainen/Maibot_plugin_qq_group_daily_analysis/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "3.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "plugin_type": "data",
  "dependencies": [
    {
      "type": "python_package",
      "name": "jinja2",
      "version_spec": ">=3.1"
    }
  ],
  "capabilities": [
    "send.image",
    "send.text",
    "llm.generate",
    "llm.get_available_models",
    "render.html2png",
    "message.get_by_time_in_chat"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "newspaper"
    }
  }
}
