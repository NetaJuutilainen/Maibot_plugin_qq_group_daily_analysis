{
  "manifest_version": 2,
  "id": "maibot-plugin-qq-group-daily-analysis",
  "version": "1.5.0",
  "changelog": "CHANGELOG.md",
  "name": "群聊每日分析",
  "description": "每天自动生成群聊日报：高光话题、神人称号、金句宝藏瓶、聊天质量锐评，12 套主题可选，支持上传 QQ 群相册；还能把日报画成四格漫画（需麦麦绘图插件）。",
  "author": {
    "name": "NetaJuutilainen",
    "url": "https://github.com/NetaJuutilainen"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/NetaJuutilainen/Maibot_plugin_qq_group_daily_analysis",
    "issues": "https://github.com/NetaJuutilainen/Maibot_plugin_qq_group_daily_analysis/issues"
  },
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.22.99"
  },
  "plugin_type": "data",
  "dependencies": [
    {
      "type": "python_package",
      "name": "jinja2",
      "version_spec": ">=3.1"
    },
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=9.0.0"
    }
  ],
  "capabilities": [
    "send.image",
    "send.text",
    "llm.generate",
    "llm.get_available_models",
    "render.html2png",
    "message.get_by_time_in_chat",
    "chat.get_avatar",
    "webui.claim_upload",
    "api.call",
    "api.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "./assets/icon.svg",
      "fallback": "newspaper"
    }
  }
}
